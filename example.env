# TinyAya Stage 2 — example .env
#
# Copy to the repo root as `.env` and fill in your own values:
#     cp example.env .env
#
# `.env` is gitignored and must never be committed. Shell scripts load it via
# `load_env_file` (scripts/tpu/_lib.sh) with precedence:
#     shell env  >  .env  >  script defaults
# so anything already exported in your shell wins over the file.
#
# Python entrypoints read these straight from the environment, so export them
# (or `set -a; . ./.env; set +a`) before running eval/publish scripts.


# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# HuggingFace token — read/write.
#   * REQUIRED: scripts/tpu/setup_gcp.sh aborts without it.
#   * Needed to pull the GATED base model `CohereLabs/tiny-aya-base`
#     (request access on HF first) and the Moshi/Mimi weights.
#   * Also used by scripts/eval_release.py and the checkpoint publishers to
#     push results/checkpoints to the Hub.
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
# RECOMMENDED — experiment tracking
# ---------------------------------------------------------------------------

# Weights & Biases API key. Training runs without it, but you lose all metrics,
# the checkpoint index, and the audio demos. setup_gcp.sh seeds it into GCP
# Secret Manager so TPU workers can log without the key ever touching the VM
# image. Create at: https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where runs land. Override to your own project/entity.
WANDB_PROJECT=tinyaya-stage2-tpu
WANDB_ENTITY=your-wandb-username


# ---------------------------------------------------------------------------
# OPTIONAL — release evaluation only (scripts/eval_release.py)
# ---------------------------------------------------------------------------

# Gemini API key: the ASR referee cross-check + the GEMBA adequacy judge.
# Only the `llm_judge` stage needs it; every other eval stage runs without it.
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
# OPTIONAL — GCP / TPU overrides
# ---------------------------------------------------------------------------
# Uncomment only what you need; each falls back to the default shown, which is
# the configuration the published v0.3 run used. Point these at your own
# project when reproducing.
#
# Keep REGION co-located with your TPUs: a cross-region bucket makes every
# checkpoint write pay egress (this was ~98% of the bill on an earlier run).

# PROJECT_ID=ml-pipelines-315702      # your GCP project
# REGION=europe-west4                 # bucket location; MUST match the TPU region
# BUCKET=tinyaya-stage2-eu            # checkpoints -> gs://$BUCKET/checkpoints/
# SECRET_HF=hf-token                  # Secret Manager name for HF_TOKEN
# SECRET_WANDB=wandb-api-key          # Secret Manager name for WANDB_API_KEY


# ---------------------------------------------------------------------------
# NOT part of `.env`: per-run launch settings
# ---------------------------------------------------------------------------
# `.env` holds credentials + account config that rarely change. Which slice,
# recipe, and corpus a run uses are passed to the launcher on the command line:
#
#   TRC_PROFILE=v6e-16-eu CONFIG_FILE=configs/tpu/stage2_tpu_v6e16_full_v03_mh.yaml \
#   SWEEP_DATA_GS_URI=gs://<bucket>/data/<corpus>.tar.gz \
#   bash scripts/tpu/launch_spot.sh
#
# OPTIONAL: to survive spot preemption unattended, save those same KEY=VALUE
# pairs to a file (conventionally `launch.env`) and point the queued-resource
# watcher at it. Any `*.env` is gitignored -- only this template is tracked -- so
# such a file can never be committed by accident. `qr_watch.sh` is the ONLY
# consumer; it re-sources the file to replay a byte-identical relaunch when the
# QR dies:
#
#   QR_NAME=<qr> ZONE=europe-west4-a LAUNCH_ENV_FILE=launch.env \
#   bash scripts/tpu/qr_watch.sh
#
# Not needed to start a run. See docs/tpu-runbook.md.
