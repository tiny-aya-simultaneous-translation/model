# --- secrets / local config ---
# Ignore EVERY dotenv-style file, then re-admit the tracked template. `launch.env`
# (per-run launcher settings) and any future `*.env` are covered by the glob --
# the docs tell people to create these, so the default must be "never committed".
*.env
.env.*
*.env.*
!example.env
.envrc

# Credential blobs that tooling drops into the repo root.
service-account*.json
*-key.json
credentials.json

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
*.egg
build/
dist/
pip-wheel-metadata/

# --- virtualenvs (uv, venv, conda) ---
.venv/
venv/
env/
.python-version

# --- editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- training artifacts (kept on GCS / W&B, not in git) ---
checkpoints/
_artifacts/
wandb/
runs/
*.log
*.tmp

# --- HF / cache ---
.cache/
.huggingface/

# --- audio scratch ---
*.wav.tmp

# --- claude memory system ---
# The tooling AND the memory files (PLAN/PROGRESS/VERIFY/memories) are tracked.
# Still excluded:
#   settings.local.json - per-machine permission grants (incl. destructive-command
#                         auto-approvals); must not be imposed on collaborators
#   archive/            - bulk session-log archives (600 KB+, no public value)
.claude/settings.local.json
.claude/hooks/__pycache__/
.claude/archive/

# Build stamp written by scripts/tpu/hot_redeploy.sh.
BUILD_SHA
